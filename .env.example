# ==============================================================================
# LAJNAH QURAN — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Policy:
# 1. Variables prefixed with VITE_* are bundled into client browser JavaScript.
#    NEVER put server secrets, bot tokens, or private keys into VITE_* variables!
# 2. Server-only secrets MUST remain unprefixed and loaded only in Node.js runtime.
# ==============================================================================

# Client-Safe Public Variables (Accessible in Browser SPA)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_TELEGRAM_BOT_USERNAME=your_bot

# Server-Side Only Secrets (Never Exposed to Browser / Never VITE_*)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_min_32_chars
FONNTE_API_TOKEN=your_fonnte_whatsapp_token
GEMINI_API_KEY=AIzaSy...
INTEGRATION_ENCRYPTION_KEY=your_aes256_encryption_key_32_chars

# Runtime Configuration
NODE_ENV=production
PORT=3000
